# Copiar a .env y completar con los valores reales (Neon, etc.). .env nunca se commitea.

# Neon: connection string "pooled" (runtime, la usa la app para queries normales).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/imperio_barber?sslmode=require"

# Neon: connection string directa (sin pooler), la necesita Prisma Migrate.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/imperio_barber?sslmode=require"

# URL del frontend desplegado en Netlify, para configurar CORS.
FRONTEND_URL="http://localhost:4200"

# Minutos que una reserva PENDING se mantiene bloqueando el horario antes de expirar sola.
BOOKING_PENDING_TTL_MINUTES=25

NODE_ENV=development

# Puerto local del backend (Render asigna el suyo propio en producción vía process.env.PORT).
PORT=3001
